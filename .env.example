APP_NAME="Librio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# local = SQLite (zero setup). On Vercel use Postgres/MySQL (see README).
DB_CONNECTION=sqlite

SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=sync

# invite | open | closed  (who can create an account)
LIBRARY_REGISTRATION=invite
# proxy = your server fetches, decrypts and streams the book (default, works on Vercel too)
# encrypted = browser downloads from the file host directly (needs a host that sends CORS headers; Postfile does not)
LIBRARY_DELIVERY=proxy
# generated for you by: php artisan library:install   (back it up! same value everywhere)
LIBRARY_MASTER_KEY=
POSTFILE_API_KEY=
LIBRARY_FORCE_HTTPS=false
LIBRARY_TRUST_PROXIES=false

# Vercel only (see .env.vercel): create tables + first admin automatically on the first visit
# LIBRARY_AUTO_SETUP=true
# LIBRARY_ADMIN_EMAIL=
# LIBRARY_ADMIN_PASSWORD=
