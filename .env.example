APP_NAME="Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# local = SQLite (zero setup). On Vercel use Postgres/MySQL (see README).
DB_CONNECTION=sqlite

SESSION_DRIVER=cookie
CACHE_STORE=database
QUEUE_CONNECTION=sync

# invite | open | closed  (who can create an account)
LIBRARY_REGISTRATION=invite
# proxy = your server streams every byte (local/VPS)   encrypted = browser decrypts from the CDN (Vercel)
LIBRARY_DELIVERY=proxy
# generated for you by: php artisan library:install   (back it up! same value everywhere)
LIBRARY_MASTER_KEY=
POSTFILE_API_KEY=
LIBRARY_FORCE_HTTPS=false
LIBRARY_TRUST_PROXIES=false
